# Development-only values. Replace every credential before an institutional pilot.
# `fssaira doctor` will tell you which of these are still defaults.

# --- system of record -------------------------------------------------------
POSTGRES_USER=fssaira
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=fssaira
REDIS_PASSWORD=change-me-redis-password

# --- credentials the control plane holds ------------------------------------
# The evidence write token must be held ONLY by the evidence service. An agent
# that can obtain it can write its own record.
FSSAI_EVIDENCE_TOKEN=change-me-evidence-token
# The approval signing key authenticates human approvals. The repository default
# is published test material; anyone who has read the repository can forge with it.
FSSAI_APPROVAL_SIGNING_KEY=change-me-approval-key
FSSAI_APPROVAL_KEY_ID=pilot-approval-key-1

# --- who may call the control plane -----------------------------------------
# token | header | oidc. Leave FSSAI_AUTH_TOKENS_JSON unset to use the published
# development tokens, which is reported as a blocking finding.
FSSAI_AUTH_MODE=token
FSSAI_AUTH_TOKENS_JSON={"change-me-operator-token":{"subject":"platform.operator","roles":["platform_operator"]},"change-me-officer-token":{"subject":"officer.one","roles":["student_support_officer"]},"change-me-second-officer-token":{"subject":"officer.two","roles":["student_support_officer"]},"change-me-agent-token":{"subject":"bounded-agent-1","roles":["proposer"]}}

# --- the import boundary ----------------------------------------------------
# One shared key per trusted publisher. This authenticates the channel, not the
# truth of the content.
FSSAI_IMPORT_SOURCE_KEYS_JSON={"demo-source":"change-me-import-source-key"}
# The reference Compose topology fixes this to a named low-side volume. Set it
# explicitly only when running the gateway outside Compose. If absent, the
# gateway still works but reports audit_durable=false and restart loses its
# quarantine/ingest evidence.
# FSSAI_IMPORT_AUDIT_PATH=/var/lib/fssaira/import-audit.sqlite3

# --- the model --------------------------------------------------------------
# ollama (default, local) | openai-compatible | deterministic (offline, for tests)
FSSAI_MODEL=ollama
FSSAI_OLLAMA_MODEL=llama3.2
# allow | deny. "deny" refuses to start rather than silently falling back to a
# rule-based stand-in when the model is unreachable.
FSSAI_MODEL_FALLBACK=allow

# --- object storage and catalog (analytics profile) -------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-minio-password

# --- what review this institution can actually supply ------------------------
# Leave these unset and the deployment enforces no review ceiling: every
# consequential action is routed to a named human, and that human is assumed to
# have unlimited attention. `fssaira doctor` reports the absence as a finding
# rather than letting it stay invisible, which is what it was before this block
# existed.
#
# These are YOUR numbers. Nothing falls back to the reference values, because a
# capacity figure inherited from a reference implementation is one nobody at
# your institution ever agreed to. Run `fssaira oversight <profile> --sweep` to
# see what a roster sustains before you commit to one.
#
# Consequential approvals one reviewer may issue per window.
# FSSAI_REVIEW_MAX_PER_WINDOW=60
# Window length, in seconds.
# FSSAI_REVIEW_WINDOW_SECONDS=3600
# Minimum seconds between presenting a proposal and accepting the approval.
# Set it to the time a careful reading genuinely takes, not the time you wish it
# took: the ceiling is only as honest as this number.
# FSSAI_REVIEW_DELIBERATION_FLOOR=45
# Approvals in a window after which a second, distinct reviewer is required.
# "none" disables escalation.
# FSSAI_REVIEW_SECOND_REVIEWER_AFTER=40
# Seconds per day a reviewer is actually available for THIS queue. Used only for
# the published capacity figure, never for enforcement.
# FSSAI_REVIEW_SECONDS_PER_DAY=14400

# --- is the reviewer's assistant independent of the proposer? ----------------
# unaided | summarised | recommended. Leave unset and reviewers are treated as
# unaided, which keeps the full deliberation floor in force.
#
# If a model helps your reviewers decide, the floor must fall or you throttle
# people doing their jobs. How far it may fall depends entirely on the three
# declarations below, because the floor was never measuring seconds — it was a
# proxy for a second mind independently reaching the same conclusion. An
# assistant that shares the proposing model and its evidence is not a second
# mind, and the deployment refuses to start if you lower the floor anyway.
# FSSAI_REVIEW_ASSISTANCE_MODE=recommended
# The role answerable for these declarations. Required whenever assistance is on.
# FSSAI_REVIEW_ASSISTANCE_DECLARED_BY=student_services
# FSSAI_REVIEW_ASSISTANT_NAME=registry-challenger
# A different model family or provider from the one that writes proposals. Two
# instances of the same model with different prompts do not qualify.
# FSSAI_REVIEW_ASSISTANT_INDEPENDENT_MODEL=true
# The assistant reads the authoritative record, not the packet the proposing
# agent assembled.
# FSSAI_REVIEW_ASSISTANT_INDEPENDENT_EVIDENCE=true
# The assistant is tasked with finding grounds to refuse, not with summarising.
# FSSAI_REVIEW_ASSISTANT_ADVERSARIAL=true

# --- how far authority may be passed on --------------------------------------
# Set this if your agents call a tool server, a plugin, a sub-agent, or anything
# your team did not write. If one agent calls one tool, leave it unset.
#
# Depth is an accountability bound rather than a security one: past some number
# of hands, nobody can answer who decided.
# FSSAI_MAX_DELEGATION_DEPTH=3
# Hops below the root at which a human must have approved the delegation for
# consequential authority to continue. 0 disables the requirement.
# FSSAI_HUMAN_APPROVAL_BELOW_DEPTH=1
# Whether a machine may pass on authority a named human had to grant. Default
# false: the human approved THIS agent acting, not its successors.
# FSSAI_ALLOW_MACHINE_DELEGATED_CONSEQUENCE=false
