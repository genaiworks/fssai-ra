# Development-only values. Replace every credential before an institutional pilot.
# `fssaira doctor` will tell you which of these are still defaults.

# --- system of record -------------------------------------------------------
POSTGRES_USER=fssaira
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=fssaira
REDIS_PASSWORD=change-me-redis-password

# --- credentials the control plane holds ------------------------------------
# The evidence write token must be held ONLY by the evidence service. An agent
# that can obtain it can write its own record.
FSSAI_EVIDENCE_TOKEN=change-me-evidence-token
# The approval signing key authenticates human approvals. The repository default
# is published test material; anyone who has read the repository can forge with it.
FSSAI_APPROVAL_SIGNING_KEY=change-me-approval-key
FSSAI_APPROVAL_KEY_ID=pilot-approval-key-1

# --- who may call the control plane -----------------------------------------
# token | header | oidc. Leave FSSAI_AUTH_TOKENS_JSON unset to use the published
# development tokens, which is reported as a blocking finding.
FSSAI_AUTH_MODE=token
FSSAI_AUTH_TOKENS_JSON={"change-me-operator-token":{"subject":"platform.operator","roles":["platform_operator"]},"change-me-officer-token":{"subject":"officer.one","roles":["student_support_officer"]},"change-me-agent-token":{"subject":"bounded-agent-1","roles":["proposer"]}}

# --- the import boundary ----------------------------------------------------
# One shared key per trusted publisher. This authenticates the channel, not the
# truth of the content.
FSSAI_IMPORT_SOURCE_KEYS_JSON={"demo-source":"change-me-import-source-key"}

# --- the model --------------------------------------------------------------
# ollama (default, local) | openai-compatible | deterministic (offline, for tests)
FSSAI_MODEL=ollama
FSSAI_OLLAMA_MODEL=llama3.2
# allow | deny. "deny" refuses to start rather than silently falling back to a
# rule-based stand-in when the model is unreachable.
FSSAI_MODEL_FALLBACK=allow

# --- object storage and catalog (analytics profile) -------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-minio-password
