  "components": {
    "schemas": {
      "ApprovalCreate": {
        "properties": {
          "ttl_seconds": {
            "type": "integer",
            "maximum": 86400.0,
            "minimum": 1.0,
            "title": "Ttl Seconds",
            "default": 300
          }
        },
        "type": "object",
        "title": "ApprovalCreate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProposalCreate": {
        "properties": {
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "operation": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Operation"
          },
          "resource_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Resource Id"
          },
          "from_status": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "From Status"
          },
          "to_status": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "To Status"
          },
          "evidence_version": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Evidence Version"
          }
        },
        "type": "object",
        "required": [
          "operation",
          "resource_id",
          "from_status",
          "to_status",
          "evidence_version"
        ],
        "title": "ProposalCreate"
      },
      "ResourceCreate": {
        "properties": {
          "resource_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Resource Id"
          },
          "status": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Status"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "resource_id",
          "status"
        ],
        "title": "ResourceCreate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
